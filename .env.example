# Local explanations are deterministic and require no network credentials.
EXPLANATION_PROVIDER=local

# Temporary live provider. Select an available model explicitly; no default is assumed.
HF_TOKEN=
HF_MODEL_ID=

# IBM watsonx.ai / Granite. Select the regional service URL and model explicitly.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=
WATSONX_MODEL_ID=

# Optional request controls.
PROVIDER_CONNECT_TIMEOUT=5
PROVIDER_READ_TIMEOUT=30
PROVIDER_MAX_OUTPUT_TOKENS=700
