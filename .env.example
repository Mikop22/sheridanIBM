# The integrated local frontend calls FastAPI directly; demo mode remains available.
NEXT_PUBLIC_SIGNALZERO_API_MODE=live
NEXT_PUBLIC_SIGNALZERO_API_BASE_URL=http://127.0.0.1:8000

# Local IBM Granite uses the existing loopback-only Ollama installation.
EXPLANATION_PROVIDER=ollama

# Local IBM Granite through Ollama. The endpoint must remain on loopback.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=granite4:3b

# Dormant hosted provider configuration retained for compatibility.
HF_TOKEN=
HF_MODEL_ID=
# Optional documented provider response alias when it differs from HF_MODEL_ID.
HF_RESPONSE_MODEL_ID=

# IBM watsonx.ai / Granite. Select the regional service URL and model explicitly.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=
WATSONX_MODEL_ID=

# Optional request controls.
PROVIDER_CONNECT_TIMEOUT=5
PROVIDER_READ_TIMEOUT=30
PROVIDER_MAX_OUTPUT_TOKENS=700

# Comma-separated explicit browser origins. Wildcards are rejected.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Security event persistence.
EVENT_DATABASE_PATH=security_events.db

# Demonstration-only escalation rank bands. These are not validated production thresholds.
ESCALATION_POLICY_VERSION=synthetic-demo-v1
ESCALATION_URGENT_MAX_RANK=5
ESCALATION_ACTION_MAX_RANK=15
ESCALATION_INVESTIGATE_UNKNOWN_MAX_RANK=15
# ASSET_INVENTORY_PATH defaults to the bundled, explicitly synthetic seven-asset inventory.

# Member 1 prediction artifact. Defaults to the tracked top-25 summary when omitted.
# Point this at submission_v1_scoreboard_2026.csv when the full export is available.
PREDICTION_ARTIFACT_PATH=../model/results/submission_v1_summary.json
# Optional freshness gate using YYYY-MM. Leave unset unless deployment requires it.
PREDICTION_ARTIFACT_MIN_SNAPSHOT_MONTH=
