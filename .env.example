# The integrated local frontend calls FastAPI directly; demo mode remains available.
NEXT_PUBLIC_SIGNALZERO_API_MODE=live
NEXT_PUBLIC_SIGNALZERO_API_BASE_URL=http://127.0.0.1:8000

# Local IBM Granite uses the existing loopback-only Ollama installation.
EXPLANATION_PROVIDER=ollama

# Local IBM Granite through Ollama. The endpoint must remain on loopback.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=granite4:3b

# Dormant hosted provider configuration retained for compatibility.
HF_TOKEN=
HF_MODEL_ID=
# Optional documented provider response alias when it differs from HF_MODEL_ID.
HF_RESPONSE_MODEL_ID=

# IBM watsonx.ai / Granite. Select the regional service URL and model explicitly.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=
WATSONX_MODEL_ID=

# Optional request controls.
PROVIDER_CONNECT_TIMEOUT=5
PROVIDER_READ_TIMEOUT=30
PROVIDER_MAX_OUTPUT_TOKENS=700

# Comma-separated explicit browser origins. Wildcards are rejected.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Security event persistence and an explicit threshold bound to its score semantics.
EVENT_DATABASE_PATH=security_events.db
EVENT_RISK_THRESHOLD=0.75
EVENT_THRESHOLD_SCALE_MINIMUM=0.0
EVENT_THRESHOLD_SCALE_MAXIMUM=1.0
EVENT_THRESHOLD_HIGHER_IS_RISKIER=true
