# The integrated local frontend calls FastAPI directly; demo mode remains available.
NEXT_PUBLIC_SIGNALZERO_API_MODE=live
NEXT_PUBLIC_SIGNALZERO_API_BASE_URL=http://127.0.0.1:8000

# Local IBM Granite uses the existing loopback-only Ollama installation.
EXPLANATION_PROVIDER=ollama

# Local IBM Granite through Ollama. The endpoint must remain on loopback.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=granite4:3b

# Dormant hosted provider configuration retained for compatibility.
HF_TOKEN=
HF_MODEL_ID=
# Optional documented provider response alias when it differs from HF_MODEL_ID.
HF_RESPONSE_MODEL_ID=

# IBM watsonx.ai / Granite. Select the regional service URL and model explicitly.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=
WATSONX_MODEL_ID=

# Optional request controls.
PROVIDER_CONNECT_TIMEOUT=5
PROVIDER_READ_TIMEOUT=30
PROVIDER_MAX_OUTPUT_TOKENS=700

# Comma-separated explicit browser origins. Wildcards are rejected.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Security event persistence and an explicit threshold bound to its score semantics.
EVENT_DATABASE_PATH=security_events.db
EVENT_RISK_THRESHOLD=0.75
EVENT_THRESHOLD_SCALE_MINIMUM=0.0
EVENT_THRESHOLD_SCALE_MAXIMUM=1.0
EVENT_THRESHOLD_HIGHER_IS_RISKIER=true

# Member 1 prediction artifact. Defaults to the tracked top-25 summary when omitted.
# Point this at submission_v1_scoreboard_2026.csv when the full export is available.
PREDICTION_ARTIFACT_PATH=../model/results/submission_v1_summary.json
# Optional freshness gate using YYYY-MM. Leave unset unless deployment requires it.
PREDICTION_ARTIFACT_MIN_SNAPSHOT_MONTH=

# Operations delivery beside the approval flow. recording stores payloads locally;
# live calls Slack/Jira/GitHub only when the matching credentials below are set.
OPERATIONS_DELIVERY=recording
# SQLite path for judge-script findings, jobs, and delivery rows.
OPERATIONS_DATABASE_PATH=operations.db

# Slack: either a webhook, or channel/app/team IDs with the Slack CLI.
SLACK_WEBHOOK_URL=
SLACK_CHANNEL_ID=
SLACK_APP_ID=
SLACK_TEAM_ID=
# Optional absolute path; SLACK_CMD is accepted as an alias. Defaults to ~/.slack/bin/slack or PATH.
SLACK_CLI_PATH=

# Jira Cloud issue create/update when OPERATIONS_DELIVERY=live.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task

# Remediation PR helpers. GITHUB_TOKEN and GH_TOKEN are aliases for the same setting.
GITHUB_TOKEN=
# GH_TOKEN=

# Entire.dev agent token used with the GitHub token for remediation PRs.
ENTIRE_TOKEN=
