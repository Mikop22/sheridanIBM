{
  "$defs": {
    "ExplanationContext": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/ExplanationEvidenceMetadata"
          },
          "title": "Evidence",
          "type": "array"
        },
        "missing_information": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Missing Information",
          "type": "array"
        },
        "model_score": {
          "title": "Model Score",
          "type": "number"
        },
        "model_version": {
          "minLength": 1,
          "title": "Model Version",
          "type": "string"
        },
        "prediction_snapshot": {
          "format": "date",
          "title": "Prediction Snapshot",
          "type": "string"
        },
        "score_meaning": {
          "minLength": 1,
          "title": "Score Meaning",
          "type": "string"
        },
        "score_scale": {
          "$ref": "#/$defs/ScoreScale"
        }
      },
      "required": [
        "prediction_snapshot",
        "model_version",
        "model_score",
        "score_scale",
        "score_meaning",
        "evidence",
        "missing_information"
      ],
      "title": "ExplanationContext",
      "type": "object"
    },
    "ExplanationEvidenceMetadata": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "source",
        "observed_at"
      ],
      "title": "ExplanationEvidenceMetadata",
      "type": "object"
    },
    "ExplanationProvider": {
      "enum": [
        "local",
        "ollama",
        "huggingface",
        "watsonx"
      ],
      "title": "ExplanationProvider",
      "type": "string"
    },
    "GenerationStatus": {
      "enum": [
        "complete",
        "unavailable",
        "invalid_output"
      ],
      "title": "GenerationStatus",
      "type": "string"
    },
    "GroundedStatement": {
      "additionalProperties": false,
      "properties": {
        "source_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "source_refs"
      ],
      "title": "GroundedStatement",
      "type": "object"
    },
    "ScoreScale": {
      "additionalProperties": false,
      "properties": {
        "higher_is_riskier": {
          "title": "Higher Is Riskier",
          "type": "boolean"
        },
        "maximum": {
          "title": "Maximum",
          "type": "number"
        },
        "minimum": {
          "title": "Minimum",
          "type": "number"
        }
      },
      "required": [
        "minimum",
        "maximum",
        "higher_is_riskier"
      ],
      "title": "ScoreScale",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "context": {
      "$ref": "#/$defs/ExplanationContext"
    },
    "generation_status": {
      "$ref": "#/$defs/GenerationStatus"
    },
    "interpretations": {
      "items": {
        "$ref": "#/$defs/GroundedStatement"
      },
      "title": "Interpretations",
      "type": "array"
    },
    "limitations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "observed_facts": {
      "items": {
        "$ref": "#/$defs/GroundedStatement"
      },
      "title": "Observed Facts",
      "type": "array"
    },
    "prediction_id": {
      "minLength": 1,
      "title": "Prediction Id",
      "type": "string"
    },
    "provider": {
      "$ref": "#/$defs/ExplanationProvider"
    },
    "provider_metadata": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Metadata"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "trace_id": {
      "minLength": 1,
      "title": "Trace Id",
      "type": "string"
    }
  },
  "required": [
    "prediction_id",
    "provider",
    "generation_status",
    "context",
    "observed_facts",
    "interpretations",
    "limitations",
    "trace_id"
  ],
  "title": "Explanation",
  "type": "object"
}
