# Python backend artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
build/
*.egg-info/
*.db
*.db-shm
*.db-wal
.pytest_tmp*/

# Dependencies
/node_modules/
/frontend/node_modules/
/.pnp
.pnp.*
# Keep authored Yarn tooling if the project adopts Yarn.
/.yarn/*
!/.yarn/patches/
!/.yarn/plugins/
!/.yarn/releases/
!/.yarn/versions/

# Generated builds and framework state
/dist/
/.output/
/.next/
/.vinext/
/.vite/
/out/
/frontend/dist/
/frontend/.output/
/frontend/.next/
/frontend/.vinext/
/frontend/.vite/
/frontend/out/
next-env.d.ts
*.tsbuildinfo

# Test output
/coverage/
/frontend/coverage/

# Package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment and keys
.env*
!.env.example
.dev.vars*
*.pem

# Checkout-local tool state
/.wrangler/
/.sites-runtime/
/frontend/.wrangler/
/frontend/.sites-runtime/

# Workspace scaffolding and publication archives
/.agents/
/.codex/
/outputs/
/work/
/frontend/outputs/
/frontend/work/

# OS metadata
.DS_Store

.vercel
/frontend/.vercel/
